# ---------------------------------------------------------------------------
# Copie este arquivo para .env e preencha os valores. O .env esta no
# .gitignore e nunca deve ser versionado.
#   cp .env.example .env        (Linux/macOS)
#   Copy-Item .env.example .env (Windows PowerShell)
# ---------------------------------------------------------------------------

# --- Provedor de LLM -------------------------------------------------------
# Chave da API DeepSeek: https://platform.deepseek.com/api_keys
FINRAG_LLM__API_KEY=sk-troque-por-sua-chave
FINRAG_LLM__BASE_URL=https://api.deepseek.com
# deepseek-v4-flash  -> rapido e barato, sem cadeia de raciocinio (padrao)
# deepseek-v4-pro    -> mais capaz e mais caro
FINRAG_LLM__MODEL=deepseek-v4-flash
FINRAG_LLM__TEMPERATURE=0.0
FINRAG_LLM__MAX_TOKENS=1024
FINRAG_LLM__TIMEOUT_SECONDS=60
# Custo por 1M de tokens em USD, usado para calcular o custo de cada resposta
FINRAG_LLM__COST_PER_MTOK_INPUT=0.28
FINRAG_LLM__COST_PER_MTOK_OUTPUT=0.42

# --- Embeddings (executados localmente via ONNX, sem custo de API) ---------
# Leve, 384 dimensoes, 220 MB de download. Padrao para CI e demo.
FINRAG_EMBEDDING__MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Alternativa de maior qualidade em portugues, 1024 dimensoes, 2,2 GB:
# FINRAG_EMBEDDING__MODEL=intfloat/multilingual-e5-large
FINRAG_EMBEDDING__SPARSE_MODEL=Qdrant/bm25
FINRAG_EMBEDDING__BATCH_SIZE=32

# --- Banco vetorial -------------------------------------------------------
# ".qdrant"                -> modo embutido com persistencia em disco (padrao)
# ":memory:"               -> sem persistencia; usado pelos testes
# "http://localhost:6333"  -> servidor do docker-compose
FINRAG_VECTORSTORE__URL=.qdrant
FINRAG_VECTORSTORE__COLLECTION=finrag_docs
FINRAG_VECTORSTORE__PERSIST_PATH=.qdrant

# --- Recuperacao ----------------------------------------------------------
FINRAG_RETRIEVAL__TOP_K_DENSE=12
FINRAG_RETRIEVAL__TOP_K_SPARSE=12
FINRAG_RETRIEVAL__TOP_K_FINAL=5
FINRAG_RETRIEVAL__RRF_K=60
# llm           -> re-rank listwise pelo proprio LLM, sem download extra
# cross_encoder -> modelo local dedicado, custo de API zero (1,1 GB de download)
# none          -> desliga o re-rank (usado no benchmark de ablacao)
FINRAG_RETRIEVAL__RERANKER=llm
FINRAG_RETRIEVAL__CROSS_ENCODER_MODEL=jinaai/jina-reranker-v2-base-multilingual

# --- Corrective RAG -------------------------------------------------------
FINRAG_GRAPH__MAX_REWRITES=2
FINRAG_GRAPH__RELEVANCE_THRESHOLD=0.5
FINRAG_GRAPH__MIN_RELEVANT_DOCS=2
FINRAG_GRAPH__ENABLE_GROUNDING_CHECK=true

# --- Observabilidade ------------------------------------------------------
FINRAG_OBSERVABILITY__LOG_LEVEL=INFO
FINRAG_OBSERVABILITY__LOG_JSON=false
FINRAG_OBSERVABILITY__TRACE_PATH=traces/spans.jsonl
# Opcional: preencha para enviar tracing tambem para o Langfuse
FINRAG_OBSERVABILITY__LANGFUSE_PUBLIC_KEY=
FINRAG_OBSERVABILITY__LANGFUSE_SECRET_KEY=
FINRAG_OBSERVABILITY__LANGFUSE_HOST=https://cloud.langfuse.com

# --- API ------------------------------------------------------------------
FINRAG_API__HOST=0.0.0.0
FINRAG_API__PORT=8000
FINRAG_API__CORS_ORIGINS=["http://localhost:8501"]
